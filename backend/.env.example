# Database (Cloud SQL via IAM auth)
MYSQL_HOST=35.234.220.201
MYSQL_PORT=3306
MYSQL_DB=pinkshieldAI_insurance
MYSQL_USER=tanuh-bcd-portal@bcd-prototypes.iam.gserviceaccount.com
MYSQL_DRIVER=pymysql
MYSQL_QUERY=charset=utf8mb4

# Cloud SQL Connector
CLOUD_SQL_CONNECTION_NAME=bcd-prototypes:asia-south1:tanuh-bcd-questionnaire-dev
USE_CLOUD_SQL_CONNECTOR=true

# GCP / Vertex AI
GCP_PROJECT=bcd-prototypes
GCP_REGION=us-east5
CLAUDE_MODEL=claude-sonnet-4-6-20250929
# Auth: all GCP services use Application Default Credentials (ADC).
# On GCE VMs: the attached service account is used automatically.
# Locally: run 'gcloud auth application-default login --impersonate-service-account=<SA_EMAIL>'

# Claude API — set ONE of these:
# Option A: Vertex AI (requires Model Garden enablement for Anthropic)
USE_VERTEX_AI=true
# Option B: Direct Anthropic API key (set env var to override Secret Manager)
# ANTHROPIC_API_KEY=

# Secrets: loaded from Google Cloud Secret Manager at startup.
# Set the env var to override (useful for local dev).
# Secret Manager names:
#   pinkshieldai-secret-key, pinkshieldai-anthropic-api-key,
#   pinkshieldai-mysql-password, pinkshieldai-mysql-ssl-ca,
#   pinkshieldai-mysql-ssl-cert, pinkshieldai-mysql-ssl-key

# Voice (Google Cloud Speech + TTS)
TTS_LANGUAGE_CODE=en-IN
TTS_VOICE_NAME=en-IN-Neural2-A
TTS_SPEAKING_RATE=1.0
STT_LANGUAGE_CODE=en-IN
STT_MODEL=chirp_2
